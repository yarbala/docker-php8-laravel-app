#!/usr/bin/with-contenv sh

# with-contenv is required: php-fpm expands ${FPM_*} / ${OPCACHE_*} in its config files from the
# container environment. OPcache is always on (conf/opcache.ini), so there is no APP_ENV switch.
# php-fpm must start as root; it drops the workers to www-data itself (pool `user`/`group`).

exec /usr/local/sbin/php-fpm --nodaemonize
